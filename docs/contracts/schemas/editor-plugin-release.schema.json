{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraphim.ai/contracts/editor-plugin-release.schema.json",
  "title": "Terraphim editor/plugin release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "channel",
    "artifacts",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "candidate",
        "stable"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "host",
          "version",
          "sourceCommit"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "host",
          "kind",
          "artifactSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "requirements",
              "video",
              "receipt",
              "test-log"
            ]
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "requirement",
          "status",
          "issue"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
